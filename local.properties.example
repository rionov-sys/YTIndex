## ==============================================================================
## Template local.properties untuk YT Index
## Salin file ini menjadi `local.properties` (sejajar dengan settings.gradle.kts)
## File `local.properties` sudah masuk .gitignore dan TIDAK AKAN di-commit.
## ==============================================================================

# Lokasi Android SDK di komputer lokal
# Windows: C:\\Users\\NAMA_USER\\AppData\\Local\\Android\\Sdk
# macOS: /Users/NAMA_USER/Library/Android/sdk
# Linux: /home/NAMA_USER/Android/Sdk
sdk.dir=

# Supabase Project Configuration
# Diambil dari dashboard Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

